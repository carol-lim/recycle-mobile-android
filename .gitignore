# Folders and files created by Android Studio & Gradle
.gradle/
build/
.idea/
captures/
*.iml

# Local configuration file (contains SDK path and other user-specific settings)
local.properties

# Build artifacts
*.apk
*.aab
*.ap_
*.dex

# Java class files
*.class

# Log files
*.log

# Keystore files (NEVER commit these to version control)
*.jks
*.keystore

# Sensitive Firebase configuration (NEVER commit this to version control)
google-services.json

# Native build files
.cxx/
.externalNativeBuild/

# macOS specific
.DS_Store
